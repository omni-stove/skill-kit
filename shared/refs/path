#!/bin/sh
# path <project-id> <what> [name...] — print the path a project keeps something at, and
# nothing else. Skills call this and use the line it prints; they do not need to know how
# it resolves. (Under the hood: it loads that project's own layout file and asks it. That
# is the layout's job, not the skill's.)
#
#   .agents/refs/path co characters_main "アリス"   -> src/co/characters/main/アリス.md
#   .agents/refs/path co world                       -> src/co/world
set -eu
_d=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$_d/layout.sh"
_p=$1
shift
load_project "$_p"
"$@"
